# Backend API untuk mode dev (npm run dev, port 3000).
# Next.js berjalan di port 3000 sedangkan backend PHP di Apache port 83,
# jadi alamat API ditulis absolut. CORS backend sudah memantulkan Origin.
#
# Identitas aplikasi (dibaca lib/app-config.ts). Ganti 2 baris ini untuk rebrand.
# basePath kosong = portal di root domain '/', console di '/control'.
NEXT_PUBLIC_APP_NAME=PCOFFIE
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_API_BASE=http://localhost:83/appservice/public/api/core
