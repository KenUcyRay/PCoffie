# Backend API untuk mode produksi (next start, port 3002 di server).
# Path relatif supaya ikut domain whoever yang membuka halaman.
#
# Identitas aplikasi (dibaca lib/app-config.ts). Ganti 2 baris ini untuk rebrand.
# basePath kosong = portal di root domain '/', console di '/control'.
# Deployed lewat subdomain pcoffie.trialab.web.id.
NEXT_PUBLIC_APP_NAME=PCOFFIE
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_API_BASE=/appservice/public/api/core
