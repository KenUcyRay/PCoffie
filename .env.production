# Backend API untuk mode produksi (next start, port 3002 di server).
# Path relatif supaya ikut domain whoever yang membuka halaman (browser).
#
# Identitas aplikasi (dibaca lib/app-config.ts). Ganti 2 baris ini untuk rebrand.
# basePath kosong = portal di root domain '/', console di '/control'.
# Deployed lewat subdomain pcoffie.trialab.web.id.
NEXT_PUBLIC_APP_NAME=PCOFFIE
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_API_BASE=/appservice/public/api/core

# Base URL API untuk Server Component (SSR). WAJIB diisi di produksi karena
# Node perlu alamat absolut untuk reach backend, sedangkan NEXT_PUBLIC_API_BASE
# di atas sengaja relatif (ikut domain browser). Port Apache PCoffie = 82.
# Tidak di-prefix NEXT_PUBLIC karena ini alamat internal server, bukan untuk browser.
SERVER_API_BASE=http://127.0.0.1:82/appservice/public/api/core
