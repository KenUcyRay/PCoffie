# Backend API untuk mode produksi (npm start, port 3000).
# Path relatif supaya ikut domain whoever yang membuka halaman.
# Identitas aplikasi (dibaca lib/app-config.ts). Ganti 2 baris ini untuk rebrand.
# Prefix /tiket-app dipakai halaman pengguna (belum ada isi).
# Control panel admin/operator hidup di /tiket-app/console.
NEXT_PUBLIC_APP_NAME=Tiket APP
NEXT_PUBLIC_BASE_PATH=/tiket-app/console
NEXT_PUBLIC_API_BASE=/tiket-app/appservice/public/api/core