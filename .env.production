# Backend API untuk mode produksi (npm start, port 3000).
# Path relatif supaya ikut domain whoever yang membuka halaman.
# Identitas aplikasi (dibaca lib/app-config.ts). Ganti 2 baris ini untuk rebrand.
# basePath aplikasi = /pcoffie. Control panel admin/operator memakai sub-path
# /pcoffie/console, portal memakai /pcoffie/ langsung.
NEXT_PUBLIC_APP_NAME=PCOFFIE
NEXT_PUBLIC_BASE_PATH=/pcoffie
NEXT_PUBLIC_API_BASE=/pcoffie/appservice/public/api/core
