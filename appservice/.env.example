APP_NAME=Lumen
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_SLACK_WEBHOOK_URL=

DB_CONNECTION=sqlsrv
DB_HOST=localhost
DB_PORT=1433
DB_DATABASE=nextlumen_db
DB_USERNAME=may
DB_PASSWORD=may

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# Kunci HMAC token QR tiket (isi manual, 64 hex dari random_bytes(32)).
QR_SECRET=

# Batas pengajuan refund (jam sebelum event mulai), rentang scan (jam),
# dan penegakan operator-berbeda untuk setujui/tolak refund.
REFUND_DEADLINE_HOURS=72
SCAN_WINDOW_HOURS=2
REFUND_ENFORCE_DIFF_OPERATOR=YES
